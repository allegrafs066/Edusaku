{
  "name": "edusaku-desktop",
  "version": "1.0.0",
  "description": "Edusaku — Offline AI for Education (Desktop)",
  "author": "Bossa Nova Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/allegrafs066/Edusaku"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build": "electron-builder --linux --win --mac"
  },
  "build": {
    "appId": "com.edusaku.desktop",
    "productName": "Edusaku",
    "copyright": "Copyright © 2024 Allegra Fernanda Santoso & Aisiya Qutwatunnada",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/node_modules/.cache/**",
          "!**/.git/**"
        ]
      },
      {
        "from": "bin",
        "to": "bin",
        "filter": ["**/*"]
      }
    ],
    "icon": "../server/client/public/icon.png",
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Education"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^29.4.6",
    "electron-builder": "^24.13.3"
  }
}
